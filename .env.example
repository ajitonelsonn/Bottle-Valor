# BotleValor environment template — copy to .env.local and fill in locally.
# NEVER put real secrets in this file or in any NEXT_PUBLIC_* variable.

# --- Google Cloud (server-only) ---
# Local dev authenticates with Application Default Credentials:
#   gcloud auth application-default login
# Cloud Run uses its attached service account. No JSON key files.
GOOGLE_CLOUD_PROJECT=botlevalor
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_LOCATION=global
GCS_PUBLIC_BUCKET=botlevalor-public
GCS_UPLOADS_BUCKET=botlevalor-uploads

# --- Firebase web config (public by design; protected by Auth + server checks) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=botlevalor.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=botlevalor
NEXT_PUBLIC_FIREBASE_APP_ID=
# Email/password sign-in (needs a verified sending domain). Google sign-in is always on.
NEXT_PUBLIC_EMAIL_PASSWORD_AUTH=false

# --- Email verification codes (server-only secret) ---
# Set locally yourself; in production store it in Secret Manager.
RESEND_API_KEY=
EMAIL_FROM="BotleValor <onboarding@resend.dev>"
# Optional extra secret mixed into stored code hashes.
EMAIL_CODE_PEPPER=
