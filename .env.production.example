# Public Firebase web config, built into the browser bundle at build time.
# These are public identifiers (not secrets). Copy this file to .env.production
# and fill in the values from Firebase console → Project settings → Your apps.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=
# Email/password sign-in needs a verified email-sending domain (see backend.md §3.4).
NEXT_PUBLIC_EMAIL_PASSWORD_AUTH=false
