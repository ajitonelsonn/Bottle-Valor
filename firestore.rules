rules_version = '2';

// BotleValor: browsers never access Firestore directly. All reads and writes
// go through the server API (Firebase Admin SDK), which authenticates the
// user and enforces business rules (points ledger, verification, rewards).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
